{
  "name": "transifex-loader",
  "version": "6.0.0",
  "description": "Webpack loader to fetch imported translation files from transifex.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/freaktechnik/transifex-loader.git"
  },
  "bugs": "https://github.com/freaktechnik/transifex-loader/issues",
  "author": "Martin Giger (https://humanoids.be)",
  "type": "module",
  "exports": {
    "import": "./src/index.mjs",
    "default": "./src/index.mjs"
  },
  "sideEffects": false,
  "engines": {
    "node": ">= 16.0.0"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "test": "npm run lint && c8 ava",
    "coverage": "c8 report --reporter lcov",
    "lint": "eslint src/ test/ package.json"
  },
  "files": [
    "src/**/*.mjs"
  ],
  "keywords": [
    "transifex",
    "webpack",
    "loader"
  ],
  "dependencies": {
    "node-fetch": "^3.3.2",
    "transifex-config": "^5.0.0"
  },
  "devDependencies": {
    "@freaktechnik/eslint-config-node": "^14.1.0",
    "@freaktechnik/eslint-config-test": "^14.1.0",
    "ava": "^8.3.0",
    "c8": "^12.0.0",
    "eslint": "^10.14.0",
    "random-string": "^0.2.0",
    "sinon": "^22.1.0"
  },
  "nyc": {
    "reporter": [
      "lcov",
      "text"
    ]
  }
}
